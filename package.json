    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
